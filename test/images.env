# Public images only. Ryuk is pinned by testcontainers-go; pause and DNS by K3s;
# the Argo and Redis versions come from the checksum-pinned Argo Core manifest.
RYUK_IMAGE=testcontainers/ryuk:0.14.0
K3S_IMAGE=rancher/k3s:v1.35.0-k3s1
PAUSE_IMAGE=rancher/mirrored-pause:3.6
DNS_IMAGE=rancher/mirrored-coredns-coredns:1.13.1
ARGO_IMAGE=quay.io/argoproj/argocd:v3.3.2
REDIS_IMAGE=public.ecr.aws/docker/library/redis:8.2.3-alpine
CHART_SERVER_IMAGE=nginx:1.28-alpine
TRINO_IMAGE=trinodb/trino:481
GATEWAY_IMAGE=trinodb/trino-gateway:22
POSTGRES_IMAGE=postgres:17-alpine
